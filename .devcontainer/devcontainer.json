{
  "name": "WOVOPS Phase 6",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-20-bullseye",
  "forwardPorts": [3000, 3002],
  "postCreateCommand": "npm ci && npx playwright install chromium",
  "postStartCommand": "npm run phase6:pilot:cloud",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.vscode-typescript-next"
      ]
    }
  },
  "containerEnv": {
    "WOVOPS_APP_URL": "http://127.0.0.1:3000",
    "WOVOPS_PILOT_SKIP_PRECHECK": "true",
    "WOVOPS_PILOT_SKIP_IPV6": "true",
    "WOVOPS_PILOT_ALLOW_HOST_ALIASES": "false",
    "WOVOPS_PILOT_FORCE_IPV4_LOOPBACK": "true",
    "APP_HOST": "127.0.0.1",
    "APP_PORT": "3000"
  },
  "remoteUser": "node"
}
